digraph AgentEngineering {
 graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.8", splines=polyline, fontname="PingFang SC", fontsize=18];
 node [shape=box, style="rounded,filled", color="#44627C", fillcolor="#F2F7FB", fontcolor="#102B42", fontname="PingFang SC", fontsize=18, margin="0.2,0.18", width=4.1];
 edge [color="#44627C", fontcolor="#304B61", fontname="PingFang SC", fontsize=15, arrowsize=0.8, penwidth=1.6];
 learning [label="学习定位与程序基础\n1 认识 Agent 工程\n2 基础预备\n（学习支撑，不是线上运行部件）", fillcolor="#F4F0FA", color="#7E659C"];
 problem [label="问题与任务设计\n3 问题发现\n4 任务验收\n5 信任边界", fillcolor="#E7F4EC", color="#498062"];
 choice [label="最小方案与产品决定\n8 方案选择\n16 完整 MVP 决策", fillcolor="#E7F4EC", color="#498062"];
 components [label="模型与环境组件\n6 外部 API\n7 模型候选\n10 检索证据\n11 写工具\n（按任务需要组合）"];
 control [label="执行组织与任务事实\n9 动作身份\n12 持久恢复\n13 固定端到端流程\n14 完整动态循环\n（预算、反馈与恢复）"];
 guard [label="评价与强制边界\n15 版本评价\n17 强制安全\n贯穿设计、实现和运行\n（观测、权限与质量护栏）", fillcolor="#FFF4E4", color="#A97A37"];
 delivery [label="服务交付与改进\n18 发布回退\n19 性能成本\n20 独立交付与复盘\n（真实使用与经济证据）"];
 {rank=same; problem;choice;}
 {rank=same; components;control;}
 {rank=same; guard;delivery;}
 learning -> problem [label="学习准备", style=dashed];
 problem -> choice [label="目标、验收与风险"];
 choice -> control [label="选择控制结构"];
 components -> control [label="组件交互", dir=both, style=dashed];
 control -> guard [label="产物与运行轨迹"];
 guard -> delivery [label="质量、安全与交付条件"];
 guard -> control [label="持续约束与评价反馈", style=dashed, constraint=false];
 guard -> choice [label="证据支持升级或放弃", style=dashed, constraint=false];
 delivery -> problem [label="真实反馈与复盘\n修订问题、方案和实现", color="#1873A8", fontcolor="#1873A8", penwidth=2.4, constraint=false];
}
