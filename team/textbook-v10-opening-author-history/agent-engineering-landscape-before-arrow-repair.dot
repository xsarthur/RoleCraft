digraph AgentEngineering {
 graph [layout=neato, overlap=true, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.8", splines=true, fontname="PingFang SC", fontsize=18];
 node [shape=box, style="rounded,filled", color="#44627C", fillcolor="#F2F7FB", fontcolor="#102B42", fontname="PingFang SC", fontsize=18, margin="0.2,0.18", width=3.9, height=2.15, fixedsize=true, pin=true];
 edge [color="#44627C", fontcolor="#304B61", fontname="PingFang SC", fontsize=15, arrowsize=0.8, penwidth=1.6];
 learning [pos="0,6.8!", label="学习定位与程序基础\n1 认识 Agent 工程\n2 基础预备\n（学习支撑）", fillcolor="#F4F0FA", color="#7E659C"];
 problem [pos="-2.3,3.9!", label="问题与任务设计\n3 问题发现\n4 任务验收\n5 信任边界", fillcolor="#E7F4EC", color="#498062"];
 choice [pos="2.3,3.9!", label="最小方案与产品决定\n8 方案选择\n16 完整 MVP 决策", fillcolor="#E7F4EC", color="#498062"];
 components [pos="-2.3,0.5!", label="模型与环境组件\n6 外部 API\n7 模型候选\n10 检索证据\n11 写工具\n（按任务需要组合）"];
 control [pos="2.3,0.5!", label="执行组织与任务事实\n9 动作身份\n12 持久恢复\n13 固定端到端流程\n14 完整动态循环\n（预算、反馈与恢复）"];
 guard [pos="-2.3,-2.9!", label="评价与强制边界\n15 版本评价\n17 强制安全\n贯穿设计、实现和运行\n（观测、权限与质量护栏）", fillcolor="#FFF4E4", color="#A97A37"];
 delivery [pos="2.3,-2.9!", label="服务交付与改进\n18 发布回退\n19 性能成本\n20 独立交付与复盘\n（真实使用与经济证据）"];
 {rank=same; problem;choice;}
 {rank=same; components;control;}
 {rank=same; guard;delivery;}
 learning -> problem [pos="-2.3,3.9!", label="学习准备", style=dashed];
 problem:e -> choice:w [pos="2.3,3.9!", label="任务条件"];
 choice -> control [pos="2.3,0.5!", label="方案落地"];
 components:e -> control:w [pos="2.3,0.5!", label="组件交互", dir=both, style=dashed];
 control -> guard [pos="-2.3,-2.9!", label="版本评价"];
 guard:e -> delivery:w [pos="2.3,-2.9!", label="交付条件"];
 guard -> control [pos="2.3,0.5!", label="持续约束", style=dashed, constraint=false];
 guard:w -> choice:w [pos="2.3,3.9!", label="评价反馈", style=dashed, constraint=false];
 delivery:e -> problem:e [pos="-2.3,3.9!", label="真实反馈\n与复盘", color="#1873A8", fontcolor="#1873A8", penwidth=2.4, constraint=false];
}
