digraph AgentEngineering {
 graph [layout=neato, overlap=true, bgcolor="white", pad="0.35", splines=true];
 node [shape=box, style="rounded,filled", color="#44627C", fillcolor="#F2F7FB", fontcolor="#102B42", fontname="PingFang SC", fontsize=18, margin="0.2,0.18", width=3.9, height=2.15, fixedsize=true, pin=true];
 edge [color="#44627C", fontcolor="#304B61", fontname="PingFang SC", fontsize=15, arrowsize=0.8, penwidth=1.6];
 learning [pos="0,6.8!", label="学习定位与程序基础\n1 认识 Agent 工程\n2 基础预备\n（学习支撑）", fillcolor="#F4F0FA", color="#7E659C"];
 problem [pos="-2.3,3.9!", label="问题与任务设计\n3 问题发现\n4 任务验收\n5 信任边界", fillcolor="#E7F4EC", color="#498062"];
 choice [pos="2.3,3.9!", label="最小方案与产品决定\n8 方案选择\n16 完整 MVP 决策", fillcolor="#E7F4EC", color="#498062"];
 components [pos="-2.3,0.5!", label="模型与环境组件\n6 外部 API\n7 模型候选\n10 检索证据\n11 写工具\n（按任务需要组合）"];
 control [pos="2.3,0.5!", label="执行组织与任务事实\n9 动作身份\n12 持久恢复\n13 固定端到端流程\n14 完整动态循环\n（预算、反馈与恢复）"];
 guard [pos="-2.3,-2.9!", label="评价与强制边界\n15 版本评价\n17 强制安全\n贯穿设计、实现和运行\n（观测、权限与质量护栏）", fillcolor="#FFF4E4", color="#A97A37"];
 delivery [pos="2.3,-2.9!", label="服务交付与改进\n18 发布回退\n19 性能成本\n20 独立交付与复盘\n（真实使用与经济证据）"];
 learning:sw -> problem:n [label="学习准备", style=dashed];
 problem:e -> choice:w;
 choice:s -> control:n [label="方案落地"];
 components:e -> control:w [dir=both, style=dashed];
 control:sw -> guard:ne [label="评价与约束", dir=both, style=dashed];
 guard:e -> delivery:w;
 // Layout points route the two feedback relations outside the teaching regions.
 feedback_l1 [shape=point, pos="-4.9,-2.9!", width=0.01, height=0.01, label="", style=invis];
 feedback_l2 [shape=point, pos="-4.9,5.15!", width=0.01, height=0.01, label="", style=invis];
 feedback_l3 [shape=point, pos="2.3,5.15!", width=0.01, height=0.01, label="", style=invis];
 guard:w -> feedback_l1 [style=dashed, arrowhead=none];
 feedback_l1 -> feedback_l2 [label="评价反馈", style=dashed, arrowhead=none];
 feedback_l2 -> feedback_l3 [style=dashed, arrowhead=none];
 feedback_l3 -> choice:n [style=dashed];
 feedback_r1 [shape=point, pos="4.9,-2.9!", width=0.01, height=0.01, label="", style=invis];
 feedback_r2 [shape=point, pos="4.9,5.5!", width=0.01, height=0.01, label="", style=invis];
 feedback_r3 [shape=point, pos="-2.3,5.5!", width=0.01, height=0.01, label="", style=invis];
 delivery:e -> feedback_r1 [color="#1873A8", penwidth=2.4, arrowhead=none];
 feedback_r1 -> feedback_r2 [label="真实反馈\n与复盘", color="#1873A8", fontcolor="#1873A8", penwidth=2.4, arrowhead=none];
 feedback_r2 -> feedback_r3 [color="#1873A8", penwidth=2.4, arrowhead=none];
 feedback_r3 -> problem:n [color="#1873A8", penwidth=2.4];
}
