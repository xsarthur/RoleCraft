# ============================================================
# Rolecraft 内测部署环境变量模板
# 复制为 .env 并填写实际值：cp .env.example .env
# ============================================================

# --- 服务端核心 ---
# HTTP 端口（Nginx 反代到此端口，保持 4318 不变）
PORT=4318
# 绑定地址：仅监听本地，由 Nginx 转发公网流量
HOST=127.0.0.1
# 公开部署模式：设为 true 才接受经 Nginx 转发的非 127.0.0.1 Host 头
PUBLIC_DEPLOYMENT=true
# 进程本地目录：PM2 日志，以及当前 Node 进程仍会打开的本地 SQLite 文件。
# 这不是生产数据库。生产账户与业务数据在腾讯云 CloudBase；
# 连接信息只放在服务器上已有的 deploy/.env，不要写入本模板，更新时不要重新生成。
ROLECRAFT_DATA_DIR=/opt/rolecraft/.runtime
# 职业 JSON 目录。Lighthouse 上必须是绝对路径。
# PM2 的 cwd 是 /opt/rolecraft。相对值 server/careers 会指到
# /opt/rolecraft/server/careers，读不到 sites/rolecraft/server/careers/*.json。
# 结果是只剩已写入 SQLite 的 agent-developer，访客引导 career_not_found，教材不加载。
# 改完后执行：pm2 restart rolecraft --update-env
ROLECRAFT_CAREERS_DIR=/opt/rolecraft/sites/rolecraft/server/careers
# 任务租约时长（毫秒），默认 15 秒
ROLECRAFT_LEASE_MS=15000

# --- 内容检索 ---
# 检索模式：semantic（本地向量模型）或 concept（仅规则匹配，资源不足时降级）
ROLECRAFT_RETRIEVAL_MODE=semantic

# --- 章节生成（OpenAI）---
# 内测阶段按需开启；不填则生成功能不可用但不影响其余服务
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://www.9898.ai/v1
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_OUTPUT_TOKENS=4096
# ROLECRAFT_GENERATION_BUDGET_USD=10
# ROLECRAFT_ESTIMATED_MAX_COST_USD=8
# OPENAI_TIMEOUT_MS=60000
# 问教材与题库对照评价复用上面的 OPENAI_API_KEY、OPENAI_BASE_URL（请求发到 ${OPENAI_BASE_URL}/responses）。
# 当前部署的 base URL 应为 https://www.9898.ai/v1。下面的模型、超时和输出长度只属于这两条学习路径，
# 不要用来修改 OPENAI_MODEL 或 GENERATE_MODEL（那两项仍只服务单章生成）。
# ASK_TEXTBOOK_MODEL=claude-sonnet-5-5
# ASK_TEXTBOOK_FALLBACK_MODEL=deepseek-v4-flash
# ASK_TEXTBOOK_TIMEOUT_MS=40000
# ASK_TEXTBOOK_MAX_OUTPUT_TOKENS=1200

# --- 题库 / 面试语音（本机 whisper.cpp）---
# 只转写浏览器上传的音频，不下载模型，也不调用外部语音供应商。
# 公网机器在 whisper.cpp 与中文模型安装好之前，/api/voice/readiness 会保持 available:false。
# 未配置时界面应如实说明识别不可用，文字作答仍然可用。
# ROLECRAFT_LOCAL_ASR_COMMAND=whisper-cli
# ROLECRAFT_LOCAL_ASR_MODEL=/绝对路径/ggml-中文模型.bin
# ROLECRAFT_LOCAL_ASR_TIMEOUT_MS=120000
# ROLECRAFT_FFMPEG_COMMAND=ffmpeg
