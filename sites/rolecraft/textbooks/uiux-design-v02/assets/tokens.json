{
  "$description": "澄明售后工作台 UI/UX v0.2 教学设计token；非应用实现或无障碍认证。",
  "version": "uiux-v02-design-1",
  "color": {
    "bg": {
      "$value": "#F3F5F9",
      "$type": "color"
    },
    "paper": {
      "$value": "#FFFFFF",
      "$type": "color"
    },
    "ink": {
      "$value": "#172B4D",
      "$type": "color"
    },
    "muted": {
      "$value": "#52627A",
      "$type": "color"
    },
    "line": {
      "$value": "#CDD6E3",
      "$type": "color"
    },
    "brand": {
      "$value": "#284DB4",
      "$type": "color"
    },
    "brandsoft": {
      "$value": "#E9EEFF",
      "$type": "color"
    },
    "good": {
      "$value": "#126E58",
      "$type": "color"
    },
    "goodsoft": {
      "$value": "#E4F4EE",
      "$type": "color"
    },
    "warn": {
      "$value": "#865100",
      "$type": "color"
    },
    "warnsoft": {
      "$value": "#FFF2D4",
      "$type": "color"
    },
    "bad": {
      "$value": "#AC2634",
      "$type": "color"
    },
    "badsoft": {
      "$value": "#FDEBEF",
      "$type": "color"
    },
    "nav": {
      "$value": "#172B4D",
      "$type": "color"
    },
    "disabled": {
      "$value": "#E9EDF3",
      "$type": "color"
    },
    "disabledink": {
      "$value": "#617087",
      "$type": "color"
    },
    "focus": {
      "$value": "#8D2CE2",
      "$type": "color"
    }
  },
  "semantic": {
    "text.primary": "{color.ink}",
    "text.secondary": "{color.muted}",
    "action.primary": "{color.brand}",
    "surface.canvas": "{color.bg}",
    "surface.default": "{color.paper}",
    "border.default": "{color.line}",
    "status.verified": "{color.good}",
    "status.pending": "{color.warn}",
    "status.danger": "{color.bad}",
    "focus.ring": "{color.focus}"
  },
  "typography": {
    "family": [
      "PingFang SC",
      "Hiragino Sans GB",
      "Microsoft YaHei",
      "Noto Sans CJK SC",
      "sans-serif"
    ],
    "body": {
      "size": 16,
      "lineHeight": 1.6
    },
    "metadata": {
      "size": 14,
      "lineHeight": 1.5
    },
    "heading": {
      "size": 24,
      "lineHeight": 1.3
    }
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "control": 8,
    "card": 12,
    "pill": 999
  },
  "control": {
    "height.default": 44,
    "height.dense": 36,
    "focus.width": 3,
    "focus.offset": 4,
    "target.note": "44为本教学设计默认；WCAG 2.5.8 AA最低24×24 CSS px并含规定例外，实际命中区域另测。"
  },
  "motion": {
    "duration.feedbackMs": 160,
    "reducedMotion": "移除非必要平移/缩放与循环动画，保留文字状态和进度说明；运行实现待测。"
  },
  "themes": {
    "t-lotus": {
      "brand": "#284DB4"
    },
    "t-maple": {
      "brand": "#16675D"
    },
    "invariant": [
      "status.verified",
      "status.pending",
      "status.danger",
      "focus.ring"
    ]
  },
  "testedPairs": [
    {
      "foreground": "ink",
      "background": "paper",
      "ratio": 14.1,
      "use": "正文",
      "scope": "sRGB色值数学自查，仅该配对；不证明整页合规"
    },
    {
      "foreground": "muted",
      "background": "paper",
      "ratio": 6.2,
      "use": "次要文字",
      "scope": "sRGB色值数学自查，仅该配对；不证明整页合规"
    },
    {
      "foreground": "brand",
      "background": "paper",
      "ratio": 7.47,
      "use": "链接",
      "scope": "sRGB色值数学自查，仅该配对；不证明整页合规"
    },
    {
      "foreground": "good",
      "background": "goodsoft",
      "ratio": 5.44,
      "use": "已核验",
      "scope": "sRGB色值数学自查，仅该配对；不证明整页合规"
    },
    {
      "foreground": "warn",
      "background": "warnsoft",
      "ratio": 5.92,
      "use": "待核验",
      "scope": "sRGB色值数学自查，仅该配对；不证明整页合规"
    },
    {
      "foreground": "bad",
      "background": "badsoft",
      "ratio": 5.94,
      "use": "错误",
      "scope": "sRGB色值数学自查，仅该配对；不证明整页合规"
    },
    {
      "foreground": "paper",
      "background": "brand",
      "ratio": 7.47,
      "use": "主按钮",
      "scope": "sRGB色值数学自查，仅该配对；不证明整页合规"
    }
  ]
}
