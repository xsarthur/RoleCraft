        "quote": "function interviewVoicePage(){const q=interviewVoiceQuestion(),v=interviewVoiceState;const statusText={ready:'准备录音',requesting:'请求麦克风',recording:'正在录音',paused:'已暂停',stopping:'正在结束录音',captured:'录音已完成',transcribing:'正在转写',transcript_ready:'等待确认转写',transcription_unavailable:'转写不可用',analyzing:'正在分析',feedback:'已生成反馈',permission_denied:'权限未授予',device_denied:'麦克风不可用',unsupported:'浏览器不支持',empty:'没有音频',error:'录音失败'}[v.status]||'准备录音';let controls='';if(v.status==='ready'||['permission_denied','device_denied','unsupported','empty','error'].includes(v.status))controls='<button class=\"primary\" data-interview-action=\"voice-start\">开始录音</button>';if(v.status==='requesting')controls='<button class=\"outline\" data-interview-action=\"voice-cancel\">取消</button>';if(v.status==='recording')controls='<button class=\"primary\" data-interview-action=\"voice-pause\">暂停</button><button class=\"outline\" data-interview-action=\"voice-stop\">停止</button>';if(v.status==='paused')controls='<button class=\"primary\" data-interview-action=\"voice-resume\">继续录音</button><button class=\"outline\" data-interview-action=\"voice-stop\">停止</button><button class=\"text-link\" data-interview-action=\"voice-delete\">放弃</button>';if(v.status==='captured')controls='<button class=\"primary\" data-interview-action=\"voice-transcribe\">使用本地转写</button><button class=\"text-link\" data-interview-action=\"voice-rerecord\">重新录音</button>';if(['transcript_ready','transcription_unavailable'].includes(v.status))controls='<button class=\"text-link\" data-interview-action=\"voice-rerecord\">重新录音</button>';if(v.status==='feedback')controls='<button class=\"outline\" data-interview-action=\"voice-rerecord-feedback\">重新录音回答</button>';const audio=v.status!=='ready'&&v.status!=='recording'&&v.status!=='paused'&&v.url?'<audio controls preload=\"metadata\" src=\"'+escapeHTML(v.url)+'\"></audio>':'';const hint=v.status==='requesting'?'请允许麦克风权限':v.status==='recording'?'说完后点击停止':v.status==='captured'?'录音完成，可转写或