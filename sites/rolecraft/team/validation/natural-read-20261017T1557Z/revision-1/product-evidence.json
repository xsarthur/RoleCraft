        "quote": "function interviewVoiceStartSpeech(requestId){const Ctor=interviewVoiceSpeechCtor();if(typeof Ctor!=='function'){interviewVoiceState.browserSpeechMode='unsupported';interviewVoiceState.browserSpeechDone=true;return;}if(!interviewVoiceState.browserSpeechOptIn){interviewVoiceState.browserSpeechMode='opted_out';interviewVoiceState.browserSpeechDone=true;return;}interviewVoiceState.browserSpeechFinal='';interviewVoiceState.browserSpeechInterim='';interviewVoiceState.browserSpeechError='';interviewVoiceState.browserSpeechProvider='unknown';interviewVoiceState.browserSpeechProviderCalled='unknown';interviewVoiceState.browserSpeechDone=true;if(typeof Ctor!=='function'){interviewVoiceState.browserSpeechMode='unsupported';return;}let recognition;try{recognition=new Ctor();}catch(error){interviewVoiceState.browserSpeechMode='error';interviewVoiceState.browserSpeechError=interviewVoiceSpeechError(error?.name||'constructor');return;}interviewVoiceState.recognition=recognition;interviewVoiceState.browserSpeechMode='starting';interviewVoiceState.browserSpeechDone=false;recognition.lang='zh-CN';recognition.continuous=true;recognition.interimResults=true;recognition.maxAlternatives=1;recognition.onstart=()=>{if(interviewVoiceState.recognition!==recognition||requestId!==interviewVoiceState.requestId)return;interviewVoiceState.browserSpeechMode='listening';render();};recognition.onresult=event=>{if(interviewVoiceState.recognition!==recognition||requestId!==interviewVoiceState.requestId)return;let finalText='',interimText='';for(let i=event.resultIndex||0;i<event.results.length;i++){const result=event.results[i],text=String(result?.[0]?.transcript||'');if(result.isFinal)finalText+=text;else interimText+=text;}if(finalText)interviewVoiceState.browserSpeechFinal+=finalText;interviewVoiceState.browserSpeechInterim=interimText;const combined=interviewVoiceSpeechLiveText().trim();if(combined){interviewVoiceState.transcript=interviewVoiceState.browserSpeechFinal.trim();interviewVoiceState.transcriptOriginal=interviewVoiceState.transcript;interviewVoiceRefreshCorrections();interviewVoiceState.transcriptSource='browser_speech';interviewVoiceState.asrMode='browser_speech';}render();};recognition.onerror=event=>{if(interviewVoiceState.recognition!==recognition||requestId!==interviewVoiceState.requestId)return;const code=String(event?.error||'error');interviewVoiceState.browserSpeechMode=code==='not-allowed'||code==='service-not-allowed'?'permission_denied':code==='network'?'network_error':'error';interviewVoiceState.browserSpeechError=interviewVoiceSpeechError(code);interviewVoiceState.browserSpeechDone=true;render();};recognition.onend=()=>{if(interviewVoiceState.recognition!==recognition||requestId!==interviewVoiceState.requestId)return;interviewVoiceState.browserSpeechDone=true;interviewVoiceState.browserSpeechMode=['error','permission_denied','network_error'].includes(interviewVoiceState.browserSpeechMode)?interviewVoiceState.browserSpeechMode:'ended';interviewVoiceState.recognition=null;const text=interviewVoiceState.browserSpeechFinal.trim();if(text&&['stopping','captured','recording','paused'].includes(interviewVoiceState.status)){interviewVoiceState.transcript=text;interviewVoiceState.transcriptSource='browser_speech';interviewVoiceState.asrMode='browser_speech';if(['stopping','captured'].includes(interviewVoiceState.status))interviewVoiceState.status='transcript_ready';}render();focusTitle();};try{recognition.start();}catch(error){interviewVoiceState.recognition=null;interviewVoiceState.browserSpeechDone=true;interviewVoiceState.browserSpeechMode='error';interviewVoiceState.browserSpeechError=interviewVoiceSpeechError(error?.name||'start');}}"
