iption_unavailable'].includes(v.status)?'<div class=\"interview-voice-error\" role=\"alert\">'+escapeHTML(v.error)+'</div>':'')+extraTranscription+'</section>'+interviewVoiceTranscriptHTML(v)+(v.status==='feedback'?interviewVoiceFeedbackHTML(v.feedback):'')+'</div>';}"
