        "quote": "document.addEventListener('change',e=>{const input=e.target;if(input.dataset.interviewQuestionFilter){interviewReadQuestionFilters();interviewSave();render();return;}if(input.dataset.interviewSpeechConsent){interviewVoiceState.browserSpeechOptIn=Boolean(input.checked);interviewVoiceState.browserSpeechDecision=interviewVoiceState.browserSpeechOptIn?'enabled':'record_only';interviewVoiceState.browserSpeechMode=interviewVoiceState.browserSpeechOptIn?'available':'opted_out';interviewVoiceState.speechConsentPrompt=false;render();focusTitle();return;}if(input.dataset.interviewField){interviewReadFields();interviewState.paperDraft.preview=null;interviewState.paperDraft.generated=null;interviewSave();render();return;}if(input.closest?.('#product-review-form')){onProductInput(input);return;}if(input.closest?.('#reflection-form')){if(['kind','type','artifactId'].includes(input.name))changeReflectionObject(input);else {captureDraft();state.reflectionDraft.dirty=true;save();}return;}if(input.dataset.project){const id=input.dataset.project,p=projects.find(p=>p.id===id),i=Number(input.dataset.check);if(!p||!Number.isInteger(i)||i<0||i>=p.checks.length)return;const list=Array.isArray(state.checks[id])?state.checks[id]:[];state.checks[id]=input.checked?[...new Set([...list,i])]:list.filter(x=>x!==i);document.querySelectorAll('[data-note]').forEach(t=>state.notes[t.dataset.note]=textValue(t.value));save();const scroll=window.scrollY;render();window.scrollTo(0,scroll);app.querySelector(`[data-project=\"${id}\"][data-check=\"${i}\"]`).focus({preventScroll:true});}});"
