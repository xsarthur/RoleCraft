digraph AgentRuntime {
 graph [layout=neato, overlap=true, bgcolor="white", pad="0.3", splines=true];
 node [shape=box, style="rounded,filled", color="#44627C", fillcolor="#F2F7FB", fontcolor="#102B42", fontname="PingFang SC", fontsize=18, margin="0.18,0.15", width=3.5, height=1.3, fixedsize=true, pin=true];
 edge [color="#44627C", fontcolor="#304B61", fontname="PingFang SC", fontsize=15, arrowsize=0.8, penwidth=1.6];
 task [pos="-2,4.8!", label="目标与允许范围\n预先定义完成条件", fillcolor="#E7F4EC", color="#498062"];
 context [pos="-2,2.8!", label="当前上下文\n读已有观察与任务状态"];
 model [pos="2,2.8!", label="模型提议\n下一步调查或候选结果"];
 runtime [pos="2,0.8!", label="可信运行时准入\n核参数与权限\n核批准与预算", fillcolor="#E7F4EC", color="#498062"];
 tools [pos="2,-1.3!", label="工具与环境\n按需读取、检索或写入\n写入前须准确授权"];
 facts [pos="-2,-1.3!", label="事实与进度记录\n保存观察和未决效果\n恢复需要时持久化"];
 judge [pos="-2,0.8!", label="当前任务判定\n按条件与证据验收\n效果未知不能算完成", fillcolor="#E7F4EC", color="#498062"];
 exit [pos="-6,0.8!", label="完成、等待或停止\n等待/停止仍保留未决事实", fillcolor="#FFF4E4", color="#A97A37"];
 task:s -> context:n ;
 context:e -> model:w;
 model:s -> runtime:n ;
 runtime:s -> tools:n ;
 tools:w -> facts:e;
 facts:n -> judge:s ;
 judge:n -> context:s [color="#1873A8", fontcolor="#1873A8", penwidth=2.4];
 runtime:sw -> facts:ne [label="不发工具", style=dashed];
 judge:w -> exit:e;

 // Detached captions are layout annotations, not runtime components.
 node [shape=plain, style="", fixedsize=false, width=0, height=0, fontsize=15, fontcolor="#304B61"];
 caption_input [pos="-3.1,3.8!", label="输入合同"];
 caption_proposal [pos="3.1,1.8!", label="提议"];
 caption_send [pos="3.1,-0.25!", label="准入后发送"];
 caption_check [pos="-3.1,-0.25!", label="核对"];
 caption_continue [pos="-3.1,1.8!", label="继续", fontcolor="#1873A8"];
}
