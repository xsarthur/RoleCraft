  "chapters": [
    {
      "id": "n01-python-model-foundations",
      "core": "为什么同一段调用逻辑会阻塞、串改状态或收下无效模型结果，以及怎样重建机制"
    },
    {
      "id": "n02-context-memory-prompt",
      "core": "哪些信息应进入当前上下文，跨任务保存哪些记忆，以及错误和话题切换怎样恢复"
    },
    {
      "id": "n03-planning-reflection",
      "core": "在观察逐步揭示依赖和风险时，怎样选择、执行并修订决策策略"
    },
    {
      "id": "n04-tools-mcp",
      "core": "当工具来自不同服务且数量增长时，怎样让模型选得准、宿主接得稳"
    },
    {
      "id": "n05-retrieval-ingestion",
      "core": "检索失败发生在入库、召回、排序还是调查策略，以及如何用基线定位"
    },
    {
      "id": "n06-graph-orchestration",
      "core": "怎样用LangGraph表达已知运行不变量，并识别框架承担和未承担的职责"
    },
    {
      "id": "n07-multiagent-a2a",
      "core": "何时分工产生净收益，以及跨角色和跨系统如何交接不失真"
    },
    {
      "id": "n08-sandbox-security",
      "core": "为什么提示规则不能约束代码的系统能力，以及限制必须落在哪一层"
    },
    {
      "id": "n09-runtime-delivery",
      "core": "失败、资源增长和未知效果出现时，怎样恢复服务而不虚报完成"
    },
    {
      "id": "n10-evaluation-projects",
      "core": "怎样把已学组件用于新业务并把结果交给独立者复现"
    }
  ]
}
